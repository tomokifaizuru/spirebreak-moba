# Godot cache (re-created on import)
.godot/
# Build artifacts
*.zip
*.tmp

# DJ source / scratch for match music (the shipped loop is match-bgm-loop.ogg)
audio/music/*.wav
audio/music/*.mp4
audio/music/*.mp3
audio/music/*.flac
audio/music/*.f32
audio/music/_render*
audio/music/*.wav.import
audio/music/*.mp4.import

# Android signing secrets (never commit)
android/*.keystore
android/*.jks
android/KEYSTORE-INFO.txt
*.apk
*.aab
*.idsig
